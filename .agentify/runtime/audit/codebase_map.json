  "pitfalls": [
    {
      "module": "lib/command.js",
      "what": "Unknown-option checking is intentionally skipped on some parse branches to preserve better unknown-command or missing-action errors.",
      "consequence": "A refactor that centralizes or always invokes the check can change public error precedence and mask more useful diagnostics.",
      "source_reference": "lib/command.js",
      "line_ref": 1601
    },
    {
      "module": "lib/command.js executable subcommands",
      "what": "Spawned executable subcommands install process signal listeners for each child and use a hard-coded source-extension search list.",
      "consequence": "Repeated dispatch can accumulate listeners, while new extensions or platform differences can cause missed executables and confusing spawn failures.",
      "source_reference": "lib/command.js",
      "line_ref": 1172
    },
    {
      "module": "lib/command.js option parsing",
      "what": "Negative command arguments are accepted only under a leaf-only parsing rule and numeric recognition regex.",
      "consequence": "Negative values in non-leaf contexts can be treated as unknown options; changing parser order risks behavioral regressions.",
      "source_reference": "tests/negatives.test.js",
      "line_ref": 191
    }
